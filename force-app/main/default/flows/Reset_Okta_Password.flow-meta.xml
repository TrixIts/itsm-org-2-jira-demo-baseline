    <description>Agentforce-invocable flow that resets an employee&apos;s Okta password via the MuleSoft for Flow Okta connector. Step 1: Looks up the Okta user by email. Step 2: Resets the user&apos;s password, triggering a reset email. Returns success/failure status to the agent.</description>
    <environments>Default</environments>
    <formulas>
        <name>CleanEmail</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!EmployeeEmail}, &quot;mailto:&quot;), SUBSTITUTE({!EmployeeEmail}, &quot;mailto:&quot;, &quot;&quot;), {!EmployeeEmail})</expression>
    </formulas>
    <formulas>
        <name>FailureMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Password reset failed for &quot; &amp; IF(ISBLANK({!EmployeeName}), {!EmployeeEmail}, {!EmployeeName} &amp; &quot; (&quot; &amp; {!EmployeeEmail} &amp; &quot;)&quot;) &amp; &quot;. Please confirm the email address is correct or contact IT support for assistance.&quot;</expression>
    </formulas>
    <formulas>
        <name>SuccessMessage</name>
        <dataType>String</dataType>
        <expression>&quot;A password reset has been initiated for &quot; &amp; IF(ISBLANK({!EmployeeName}), {!EmployeeEmail}, {!EmployeeName} &amp; &quot; (&quot; &amp; {!EmployeeEmail} &amp; &quot;)&quot;) &amp; &quot;. They will receive an email with instructions to set a new password.&quot;</expression>
    </formulas>
    <interviewLabel>Reset Okta Password {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reset Okta Password</label>
