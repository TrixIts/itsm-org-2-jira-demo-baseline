    <description>Agentforce-invocable flow that provisions Dropbox access for an employee via the MuleSoft for Flow Okta connector. Step 1: Looks up the Okta user by email. Step 2: Assigns the user to the Dropbox application in Okta. Returns success/failure status to the agent.</description>
    <environments>Default</environments>
    <formulas>
        <name>FailureMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Dropbox provisioning failed for &quot; &amp; {!EmployeeName} &amp; &quot; (&quot; &amp; {!EmployeeEmail} &amp; &quot;). Please contact IT support for assistance.&quot;</expression>
    </formulas>
    <formulas>
        <name>SuccessMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Dropbox has been successfully provisioned for &quot; &amp; {!EmployeeName} &amp; &quot; (&quot; &amp; {!EmployeeEmail} &amp; &quot;) in the &quot; &amp; {!Department} &amp; &quot; department.&quot;</expression>
    </formulas>
