    <description>Agentforce-invocable flow that posts welcome messages to department-specific Slack channels for new employees. Looks up the department config to determine which channels to post to, then sends welcome messages via the native Slack integration.</description>
    <environments>Default</environments>
    <formulas>
        <name>FailureMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Failed to add &quot; &amp; {!EmployeeName} &amp; &quot; to Slack channels for the &quot; &amp; {!Department} &amp; &quot; department. Please contact IT support.&quot;</expression>
    </formulas>
    <formulas>
        <name>SuccessMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Welcome messages have been posted for &quot; &amp; {!EmployeeName} &amp; &quot; to the following &quot; &amp; {!Department} &amp; &quot; Slack channels: #marketing-announcements, #marketing-brainstorms, #marketing-projects, #marketing-support, and #sales-and-marketing.&quot;</expression>
    </formulas>
    <formulas>
        <name>WelcomeMessage</name>
        <dataType>String</dataType>
        <expression>&quot;:wave: Welcome to the team, &quot; &amp; {!EmployeeName} &amp; &quot;! They&apos;ve just joined the &quot; &amp; {!Department} &amp; &quot; department. Say hello!&quot;</expression>
    </formulas>
    <interviewLabel>Add Employee to Slack Channels {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add Employee to Slack Channels</label>
