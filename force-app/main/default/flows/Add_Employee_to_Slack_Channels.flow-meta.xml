<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Agentforce-invocable flow that posts welcome messages to department-specific Slack channels for new employees. Looks up the department config to determine which channels to post to, then sends welcome messages via the native Slack integration.</description>
    <environments>Default</environments>
    <interviewLabel>Add Employee to Slack Channels {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add Employee to Slack Channels</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Draft</status>
    <variables>
        <name>EmployeeEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>EmployeeName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Department</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>SlackChannelStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>IsSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <constants>
        <name>SlackAppId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>A01RDL2NJAH</stringValue>
        </value>
    </constants>
    <constants>
        <name>SlackWorkspaceId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>T081Y7GKGSV</stringValue>
        </value>
    </constants>
    <formulas>
        <name>WelcomeMessage</name>
        <dataType>String</dataType>
        <expression>":wave: Welcome to the team, " &amp; {!EmployeeName} &amp; "! They've just joined the " &amp; {!Department} &amp; " department. Say hello!"</expression>
    </formulas>
    <formulas>
        <name>SuccessMessage</name>
        <dataType>String</dataType>
        <expression>"Welcome messages have been posted for " &amp; {!EmployeeName} &amp; " to the following " &amp; {!Department} &amp; " Slack channels: #marketing-announcements, #marketing-brainstorms, #marketing-projects, #marketing-support, and #sales-and-marketing."</expression>
    </formulas>
    <formulas>
        <name>FailureMessage</name>
        <dataType>String</dataType>
        <expression>"Failed to add " &amp; {!EmployeeName} &amp; " to Slack channels for the " &amp; {!Department} &amp; " department. Please contact IT support."</expression>
    </formulas>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Department_Config</targetReference>
        </connector>
    </start>
    <recordLookups>
        <name>Get_Department_Config</name>
        <label>Get Department Config</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Config_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Department</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Provisioning_Config__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Config_Found</name>
        <label>Config Found?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Set_Failure_Response</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Config</defaultConnectorLabel>
        <rules>
            <name>Yes_Config_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Department_Config</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Post_to_Marketing_Announcements</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
