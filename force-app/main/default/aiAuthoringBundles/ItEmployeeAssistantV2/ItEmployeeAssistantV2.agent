      set @variables.current_scope_hint = "Onboarding, offboarding, promotions, transfers, manager changes, resignations, and related access-change requests."
      transition to @topic.shared_service_request_intake

topic compliance_domain:
  description: "Select the compliance-management domain and hand off to shared IT intake."
  reasoning:
    instructions: ->
      set @variables.current_domain = "compliance"
      set @variables.current_topic_api_name = "ComplianceManagement"
      set @variables.current_scope_hint = "Compliance, privacy, policy adherence, governance, audit support, and mandatory reporting or training requests."
      transition to @topic.shared_service_request_intake

topic shared_service_request_intake:
  description: "Shared intake for new IT issues and managed service-request workflows across all IT domains."
  actions:
    answer_questions_with_knowledge:
      description: "Search managed IT knowledge and summarize grounded guidance for the employee's current issue or how-to request."
      inputs:
        query: string
          description: "The employee's natural-language issue description or question."
          is_required: True
          is_user_input: True
        citationsUrl: string
          description: "Optional citations URL override for custom surfaces."
        ragFeatureConfigId: string
          description: "Managed RAG feature configuration for the knowledge-answer action."
        citationsEnabled: boolean
          description: "Whether citations should be included in the managed response."
      outputs:
        knowledgeSummary: object
          description: "Grounded knowledge summary for the current request."
          complex_data_type_name: "lightning__richTextType"
          is_displayable: False
          is_used_by_planner: True
        citationSources: object
          description: "Citation sources returned by the managed knowledge answer action."
          complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
          is_displayable: False
          is_used_by_planner: True
      target: "standardInvocableAction://streamKnowledgeSearch"
      source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"
    get_eligible_service_catalog_items:
      description: "Classify the current request into eligible service catalog items for the active IT domain."
      inputs:
        queryDescription: string
          description: "The employee request to classify into service catalog options."
          is_required: True
        topicName: string
          description: "Legacy Builder topic API name for the active domain."
          is_required: True
        channelType: string
          description: "Optional channel type for managed messaging-based experiences."
        messagingChannelId: string
          description: "Optional messaging channel identifier used by the legacy managed action."
      outputs:
        serviceCtlgItemsList: list[object]
          description: "Eligible service catalog items returned for the current request."
          complex_data_type_name: "@apexClassType/svc_emp_intelligence__GetEligSvcCtlgItemsApex"
          is_displayable: False
          is_used_by_planner: True
      target: "standardInvocableAction://getEligSvcCtlgItems"
      source: "svc_emp_intelligence__GetEligibleServiceCatalogItems"
    get_svc_catalog_attributes:
      description: "Load required attributes for a selected service catalog item before a request is created."
      inputs:
        productId: id
          description: "Service catalog item record identifier."
          is_required: True
      outputs:
        svcCatalogItmAttributes: list[object]
          description: "Service catalog attributes that must be collected for the selected item."
          complex_data_type_name: "@apexClassType/svc_emp_intelligence__ServiceCatalogItemAttributeApex"
          is_displayable: False
          is_used_by_planner: True
      target: "standardInvocableAction://getSvcCtlgAttributes"
      source: "svc_emp_intelligence__GetSvcCatalogAttributes"
    create_service_catalog_request:
      description: "Create a managed service request after the required service catalog attributes are collected."
      inputs:
        productId: id
          description: "Service catalog item record identifier."
          is_required: True
        sciAttributes: list[object]
          description: "Fully populated service catalog attribute payload for the selected item."
          complex_data_type_name: "@apexClassType/svc_emp_intelligence__ServiceCatalogItemAttributeDataApex"
      outputs:
        requestStatus: string
          description: "Request-creation status."
          is_displayable: False
          is_used_by_planner: True
        createdTicket: object
          description: "Created ticket metadata when the request succeeds."
          complex_data_type_name: "lightning__recordInfoType"
          is_displayable: True
          is_used_by_planner: True
        requiredAttributes: list[string]
          description: "Any required attributes that were missing or invalid."
          is_displayable: False
          is_used_by_planner: True
      target: "standardInvocableAction://createSvcCatalogReq"
      source: "svc_emp_intelligence__CreateServiceCatalogRequest"
    get_product_launch_card:
      description: "Return the launch URL and display details for a complex service catalog item."
      inputs:
        productId: string
          description: "Selected product or process identifier."
          is_required: True
        siteName: string
          description: "Optional site context for launch-card generation."
        channelType: string
          description: "Optional channel type for launch-card generation."
      outputs:
        launchUrl: string
          description: "Launch URL for the complex request."
          is_displayable: True
          is_used_by_planner: True
        productName: string
          description: "Display name of the complex service item."
          is_displayable: True
          is_used_by_planner: True
        imageUrl: string
          description: "Image associated with the product launch card."
          is_displayable: True
          is_used_by_planner: True
        productDesc: string
          description: "Description of the complex service item."
          is_displayable: True
          is_used_by_planner: True
      target: "standardInvocableAction://getDynamicEnhancedLink"
      source: "sc_enterprise_catalog__GetProductLaunchCard"
    create_incident_for_employee:
      description: "Create a new employee IT incident after the employee explicitly agrees to incident creation."
      inputs:
        chatContext: string
          description: "Conversation context used by the managed incident-creation action."
          is_required: True
      outputs:
        IncidentNumber: string
          description: "Identifier of the created incident."
          is_displayable: False
          is_used_by_planner: True
      target: "standardInvocableAction://createIncidentForRequestor"
      source: "svc_emp_intelligence__CreateIncidentForEmployee"
    create_jira_issue:
      description: "Create a Jira issue directly through Jira REST so Jira remains the operational backend."
      inputs:
        jiraSummary: string
          description: "Short Jira summary for the employee's issue."
          is_required: True
        jiraDescription: string
          description: "Detailed Jira description for the employee's issue."
          is_required: True
        jiraPriority: string
          description: "Jira priority name, such as Low, Medium, High, or Highest."
        jiraUrgencyOptionId: string
          description: "Jira urgency option id. Critical=10020, High=10021, Medium=10022, Low=10023."
        jiraImpactOptionId: string
          description: "Jira impact option id. Extensive=10000, Significant=10001, Moderate=10002, Minor=10003."
        jiraSeverityOptionId: string
          description: "Jira severity option id. Sev-0=10028, Sev-1=10029, Sev-2=10030, Sev-3=10031."
        requesterEmail: string
          description: "Requester email when available."
        channel: string
          description: "Origin channel for the issue."
        sourceReference: string
          description: "Optional source reference for correlation."
        reporterSalesforceUsername: string
          description: "Optional Salesforce username override for resolving the Jira reporter account mapping. Leave blank to use the running Salesforce username."
      outputs:
        isSuccess: boolean
          description: "Whether Jira issue creation succeeded."
          is_displayable: False
          is_used_by_planner: True
        message: string
          description: "Result message returned by the direct Jira create action."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueKey: string
          description: "Created Jira issue key when the create succeeds."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueId: string
          description: "Created Jira issue id when the create succeeds."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueUrl: string
          description: "Browse URL for the created Jira issue when configured."
          is_displayable: False
          is_used_by_planner: True
      target: "apex://JiraCreateIssueAction"
  reasoning:
    instructions: ->
      if @variables.last_jira_create_result != "":
        | Reuse this Jira create result when it directly answers the employee's follow-up: {!@variables.last_jira_create_result}

      if @variables.last_salesforce_incident_number != "":
        | Reuse this latest Salesforce incident number when it directly helps the employee: {!@variables.last_salesforce_incident_number}

      if @variables.launch_card_url != "":
        | A launch card is available for {!@variables.launch_card_name}. Share the launch link and explain that the employee can finish the complex request there: {!@variables.launch_card_url}
        set @variables.launch_card_url = ""
        set @variables.launch_card_name = ""

      | You are handling the {!@variables.current_domain} domain.
      | Scope reminder: {!@variables.current_scope_hint}
      | Start with knowledge for troubleshooting, how-to guidance, and informational questions when the employee is mainly asking for help or diagnostics.
      | If the employee explicitly asks to create, log, open, or submit a Jira ticket or incident now, do not force a knowledge-first step.
      | When the employee clearly wants a new Jira-backed issue created now, call {!@actions.create_jira_issue_now} as the first operational action in the turn.
      | Do not call {!@actions.search_knowledge}, {!@actions.search_catalog}, {!@actions.create_service_request}, {!@actions.create_incident_now}, or {!@actions.create_incident_from_saved_context} before {!@actions.create_jira_issue_now} in that same turn.
      | If the issue is clearly urgent, high-impact, security-sensitive, device-blocking, or preventing the employee from working, prefer incident creation over extra troubleshooting.
      | If knowledge resolves the issue, confirm the employee is done and do not create a new incident or request unless they still want one logged.
      | If knowledge does not resolve the issue, use {!@actions.get_eligible_service_catalog_items} to identify whether this is a catalog-backed request.
      | When there is one strong catalog match, confirm only the item name with the employee before collecting attribute values.
      | For SIMPLE catalog items, use {!@actions.get_svc_catalog_attributes}, collect all required values except subject and reportedBy, and then use {!@actions.create_service_catalog_request}.
      | For COMPLEX catalog items, use {!@actions.get_product_launch_card} and share the returned launch URL instead of manually collecting fields.
      | For operational incidents that should be tracked in Jira, use {!@actions.create_jira_issue_now} first so Jira remains the primary backend.
      | If internal Salesforce tracking is also useful after Jira issue creation, then use {!@actions.create_incident_now} or {!@actions.create_incident_from_saved_context} to create the Salesforce Incident shadow record.
      | When using the direct Jira create action, provide a concise Jira summary, a fuller description, and the best available priority and Impact/Urgency/Severity option ids. Use Medium defaults when the user does not express stronger urgency.
      | If you expect a later confirmation turn, call {!@actions.store_incident_context} to save a concise summary of the underlying issue, affected device or system, and key symptoms before asking whether an incident should be created.
      | Use {!@actions.create_incident_now} when the employee is already asking to log the issue now and the current utterance contains enough detail to create the incident directly.
      | Use {!@actions.create_incident_from_saved_context} when the employee confirms incident creation after prior discussion and the current utterance is mostly just confirmation text.
      | After the Jira create action succeeds, tell the employee that the Jira-backed issue was created.
      | After the Salesforce incident action succeeds, include the returned incident number and explain that it is the internal Salesforce tracking record when both systems are involved.
      | If the employee is really asking about an existing ticket, route to ticket follow-up instead of staying in new-request intake.
      | If the employee is asking about currently assigned hardware, acknowledge that direct assigned-asset lookup is not yet wired in this first migration cut and help them with the surrounding hardware request or route them to human support.
    actions:
      store_incident_context: @utils.setVariables
        description: "Store a concise summary of the employee's issue before asking whether an incident should be created."
        with pending_incident_context = ...
      search_knowledge: @actions.answer_questions_with_knowledge
        description: "Search managed IT knowledge and share grounded guidance for the active domain request."
        with query = @system_variables.user_input
        with citationsUrl = ""
        with ragFeatureConfigId = "AiRagFeaturePromptContent_9a1af33c_641d_445e_9713_8b619182a610"
        with citationsEnabled = False
      search_catalog: @actions.get_eligible_service_catalog_items
        description: "Classify the current domain request against the managed service catalog."
        with queryDescription = @system_variables.user_input
        with topicName = @variables.current_topic_api_name
        with channelType = ""
        with messagingChannelId = ""
      load_catalog_attributes: @actions.get_svc_catalog_attributes
        description: "Load the required attributes for the selected service catalog item after the employee confirms the item."
        with productId = ...
      create_service_request: @actions.create_service_catalog_request
        description: "Create a service request after all required attributes are collected and validated."
        with productId = ...
        with sciAttributes = ...
      get_launch_card: @actions.get_product_launch_card
        description: "Open the launch-card experience for a complex catalog item."
        with productId = ...
        with siteName = ""
        with channelType = ""
        set @variables.launch_card_url = @outputs.launchUrl
        set @variables.launch_card_name = @outputs.productName
      create_jira_issue_now: @actions.create_jira_issue
        description: "Create a Jira issue for the employee's current operational incident so Jira remains the primary backend."
        with jiraSummary = ...
        with jiraDescription = @system_variables.user_input
        with jiraPriority = ...
        with jiraUrgencyOptionId = ...
        with jiraImpactOptionId = ...
        with jiraSeverityOptionId = ...
        with requesterEmail = ""
        with channel = "Agentforce Employee Assistant"
        with sourceReference = ""
        with reporterSalesforceUsername = ""
        set @variables.last_jira_create_result = @outputs.message
        set @variables.pending_jira_issue_key = @outputs.jiraIssueKey
      create_incident_now: @actions.create_incident_for_employee
        description: "Create a new employee IT incident immediately when the employee is clearly asking to log the issue now and the current turn already describes the problem."
        with chatContext = @system_variables.user_input
        set @variables.last_salesforce_incident_number = @outputs.IncidentNumber
        set @variables.pending_incident_context = ""
      create_incident_from_saved_context: @actions.create_incident_for_employee
        description: "Create a new employee IT incident after prior troubleshooting or follow-up when the issue summary was already stored."
        with chatContext = @variables.pending_incident_context
        set @variables.last_salesforce_incident_number = @outputs.IncidentNumber
        set @variables.pending_incident_context = ""
      go_to_ticket_followup: @utils.transition to @topic.ticket_followup
        description: "Move to existing ticket follow-up when the employee asks about an existing incident, case, or service request."
      go_to_policy_query: @utils.transition to @topic.policy_query
        description: "Move to policy query when the employee switches into company policy or benefits questions."
      go_to_escalation: @utils.transition to @topic.escalation
        description: "Move to escalation when the employee explicitly wants human assistance."
      back_to_router: @utils.transition to @topic.topic_router
        description: "Return to the main router when the conversation changes topics."

topic ticket_followup:
  description: "Handle follow-up on existing Jira issues, incidents, service requests, and cases."
  actions:
    identify_record_by_name:
      description: "Resolve a ticket number or record name into Salesforce ticket records before follow-up actions run."
      inputs:
        recordName: string
          description: "Ticket number or record name provided by the employee."
          is_required: True
          is_user_input: True
        objectApiName: string
          description: "Optional object API name if the ticket object is already known."
      outputs:
        searchResults: list[object]
          description: "Matching record candidates ranked by relevance."
          complex_data_type_name: "lightning__recordInfoType"
          is_displayable: True
          is_used_by_planner: True
      target: "standardInvocableAction://identifyRecordByName"
      source: "EmployeeCopilot__IdentifyRecordByName"
    get_relevant_tickets_by_description:
      description: "Search for the employee's relevant tickets when they describe a problem instead of naming a specific record."
      inputs:
        userQuery: string
          description: "Employee description used to find matching tickets."
          is_required: True
          is_user_input: True
        useCase: string
          description: "Use case that shapes the ticket search behavior."
          is_required: True
      outputs:
        relevantTickets: string
          description: "Formatted relevant ticket results."
          is_displayable: False
          is_used_by_planner: True
      target: "flow://svc_emp_intelligence__GetTcktsByDesc"
      source: "svc_emp_intelligence__GetRelevantTicketsByDescription"
    summarize_ticket_for_employee:
      description: "Summarize the current state of a selected ticket for the employee."
      inputs:
        "Input:recordId": string
          description: "Record identifier of the selected ticket."
          is_required: True
      outputs:
        promptResponse: string
          description: "Prompt-generated ticket summary."
          is_displayable: False
          is_used_by_planner: True
      target: "generatePromptResponse://svc_emp_intelligence__SummarizeRecord"
      source: "svc_emp_intelligence__SummarizeTicketForEmployee"
    reopen_ticket:
      description: "Reopen a selected ticket after the employee explicitly confirms the reopen request."
      inputs:
        recordId: object
          description: "Record identifier of the ticket to reopen."
          complex_data_type_name: "lightning__recordIdType"
          is_required: True
      outputs:
        resultSummary: string
          description: "Result of the reopen action."
          is_displayable: False
          is_used_by_planner: True
      target: "flow://svc_emp_intelligence__ReopenTicket"
      source: "svc_emp_intelligence__ReopenTicket"
    add_comment_to_ticket:
      description: "Add an employee-approved comment to a selected ticket."
      inputs:
        recordID: object
          description: "Record identifier of the ticket to update."
          complex_data_type_name: "lightning__recordIdType"
          is_required: True
        commentText: string
          description: "Exact comment text approved by the employee."
          is_required: True
      outputs:
        outputMessage: string
          description: "Result of the comment action."
          is_displayable: False
          is_used_by_planner: True
      target: "flow://svc_emp_intelligence__AddCmntToTkt"
      source: "svc_emp_intelligence__AddCommentToTicket"
    get_jira_issue_by_key:
      description: "Read a Jira issue directly by exact Jira key, including recent update context from Jira comments and field history when available."
      inputs:
        jiraIssueKey: string
          description: "Exact Jira issue key."
          is_required: True
      outputs:
        isSuccess: boolean
          description: "Whether the Jira issue lookup succeeded."
          is_displayable: False
          is_used_by_planner: True
        message: string
          description: "Planner-friendly Jira issue summary."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueKey: string
          description: "Jira issue key returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueId: string
          description: "Jira issue id returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        jiraSummary: string
          description: "Jira issue summary returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        jiraStatus: string
          description: "Jira issue status returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        jiraPriority: string
          description: "Jira issue priority returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        jiraResolution: string
          description: "Jira resolution returned by the direct lookup when the issue is already resolved or closed."
          is_displayable: False
          is_used_by_planner: True
        isClosed: boolean
          description: "Whether the Jira issue appears closed or resolved."
          is_displayable: False
          is_used_by_planner: True
        latestUpdateSummary: string
          description: "Concise latest-update summary derived from the newest Jira comment or field-history event."
          is_displayable: False
          is_used_by_planner: True
        recentCommentsSummary: string
          description: "Recent Jira comments or internal notes returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
        recentHistorySummary: string
          description: "Recent Jira field-history changes returned by the direct lookup."
          is_displayable: False
          is_used_by_planner: True
      target: "apex://JiraGetIssueByKeyAction"
    get_my_open_jira_issues:
      description: "Find the current employee's open Jira issues by mapping Salesforce username to a Jira reporter account id and include the latest Jira update context for each returned issue."
      inputs:
        reporterSalesforceUsername: string
          description: "Optional Salesforce username override for reporter mapping. Leave blank to use the running Salesforce username."
        maxResults: object
          description: "Maximum Jira issues to return for the open-issue lookup."
          complex_data_type_name: "lightning__integerType"
      outputs:
        isSuccess: boolean
          description: "Whether the reporter-based Jira search succeeded."
          is_displayable: False
          is_used_by_planner: True
        message: string
          description: "Planner-friendly result of the reporter-based Jira search."
          is_displayable: False
          is_used_by_planner: True
        issueCount: object
          description: "Count of open Jira issues returned for the reporter."
          complex_data_type_name: "lightning__integerType"
          is_displayable: False
          is_used_by_planner: True
        issuesSummary: string
          description: "Formatted summary of the reporter's open Jira issues."
          is_displayable: False
          is_used_by_planner: True
        firstJiraIssueKey: string
          description: "First Jira issue key returned by the reporter-based search."
          is_displayable: False
          is_used_by_planner: True
        firstIssueLatestUpdateSummary: string
          description: "Latest Jira update summary for the first issue returned by the reporter-based search."
          is_displayable: False
          is_used_by_planner: True
        firstIssuePriority: string
          description: "Priority of the first Jira issue returned by the reporter-based search."
          is_displayable: False
          is_used_by_planner: True
      target: "apex://JiraGetMyOpenIssuesAction"
    update_jira_issue:
      description: "Update a Jira issue directly by exact Jira key or id when the employee wants Jira-backed ticket details changed."
      inputs:
        jiraIssueIdOrKey: string
          description: "Exact Jira issue id or key."
          is_required: True
        jiraSummary: string
          description: "Updated Jira summary when needed."
        jiraImpactOptionId: string
          description: "Updated Jira impact option id."
        jiraUrgencyOptionId: string
          description: "Updated Jira urgency option id."
        jiraSeverityOptionId: string
          description: "Updated Jira severity option id."
        commentText: string
          description: "Optional Jira comment text to add after explicit employee confirmation."
      outputs:
        isSuccess: boolean
          description: "Whether the Jira issue update succeeded."
          is_displayable: False
          is_used_by_planner: True
        message: string
          description: "Result message returned by the direct Jira update action."
          is_displayable: False
          is_used_by_planner: True
        jiraIssueKey: string
          description: "Jira issue key returned by the update action."
          is_displayable: False
          is_used_by_planner: True
        jiraStatus: string
          description: "Jira status returned after the update."
          is_displayable: False
          is_used_by_planner: True
      target: "apex://JiraUpdateIssueAction"
  reasoning:
    instructions: ->
      if @variables.last_ticket_summary != "":
        | Reuse this ticket summary when it directly answers the employee's follow-up: {!@variables.last_ticket_summary}

      if @variables.last_ticket_action_result != "":
        | Reuse this ticket-action result when it directly answers the employee's follow-up: {!@variables.last_ticket_action_result}

      if @variables.last_ticket_search_results != "":
        | Use these ticket search results exactly as returned when helping the employee choose the correct record: {!@variables.last_ticket_search_results}

      if @variables.last_jira_lookup_result != "":
        | Reuse this Jira lookup result when it directly answers the employee's follow-up: {!@variables.last_jira_lookup_result}

      if @variables.last_jira_update_result != "":
        | Reuse this Jira update result when it directly answers the employee's follow-up: {!@variables.last_jira_update_result}

      | Handle follow-up on existing Jira issues, incidents, service requests, and cases.
      | Jira is the preferred operational source of truth when the employee provides an exact Jira key such as IT-123.
      | Use neutral, employee-friendly phrasing when summarizing Jira results. Prefer concise sentences over raw field dumps.
      | Jira lookup outputs can include priority, recent comments, field-history changes, closed-ticket signals, and a latest-update summary. Prefer that Jira context when the employee asks what changed recently.
      | If the employee provides an exact Jira key, store it, keep the conversation anchored to Jira terminology, and use {!@actions.fetch_jira_issue_by_key} before summarizing or updating the Jira-backed ticket.
      | If the employee asks for their own open Jira issues and does not name a specific key, use {!@actions.fetch_my_open_jira_issues} first.
      | If a Jira lookup shows the issue is already closed or resolved, say that plainly. Offer to add a follow-up comment or create a new request if the issue returned. Do not imply that direct Jira reopen support exists unless the employee explicitly asks for a Jira-side change and the returned Jira data suggests a valid path.
      | If the employee provides a Salesforce incident number, service request, or case instead of a Jira key, use {!@actions.identify_record_by_name} and the existing Salesforce follow-up actions.
      | If the employee wants a status update or summary but does not name a specific Jira key or Salesforce ticket, use the matching {!@actions.get_relevant_tickets_by_description} search action first.
      | If exactly one relevant ticket is clear from the search results, continue with that ticket instead of asking "which ticket."
      | If multiple tickets are plausible, ask the employee to choose the ticket before using summarize, reopen, or comment actions.
      | Use {!@actions.update_selected_jira_ticket} only when the employee clearly wants to change Jira-backed details and an exact Jira key is already known.
      | Use {!@actions.add_comment_to_ticket} and {!@actions.reopen_ticket} for Salesforce-managed tickets. Use {!@actions.update_selected_jira_ticket} for direct Jira comments or field changes when an exact Jira key is known.
      | Before {!@actions.reopen_ticket}, explicitly confirm that the employee wants to reopen the selected ticket.
      | Before {!@actions.add_comment_to_ticket} or a Jira comment through {!@actions.update_selected_jira_ticket}, explicitly confirm both the chosen ticket and the exact comment text. Never rewrite the comment without reconfirming it.
      | If the request is actually a new issue or service request, route back to shared service intake.
    actions:
      store_explicit_jira_key: @utils.setVariables
        description: "Store an exact Jira key such as IT-123 when the employee provides it."
        with pending_jira_issue_key = ...
      fetch_jira_issue_by_key: @actions.get_jira_issue_by_key
        description: "Read a Jira-backed ticket directly when the employee provides an exact Jira key."
        available when @variables.pending_jira_issue_key != ""
        with jiraIssueKey = @variables.pending_jira_issue_key
        set @variables.last_jira_lookup_result = @outputs.message
      fetch_my_open_jira_issues: @actions.get_my_open_jira_issues
        description: "Find the current employee's open Jira issues by reporter mapping when they ask about their own Jira tickets or recent Jira updates."
        with reporterSalesforceUsername = ""
        with maxResults = 5
        set @variables.last_jira_lookup_result = @outputs.issuesSummary
      identify_ticket: @actions.identify_record_by_name
        description: "Resolve a named ticket or ticket number into a concrete ticket record."
        with recordName = ...
        with objectApiName = ""
      search_tickets_for_status: @actions.get_relevant_tickets_by_description
        description: "Search relevant tickets when the employee wants a ticket update or summary."
        with userQuery = @system_variables.user_input
        with useCase = "ticketStatusUpdate"
        set @variables.last_ticket_search_results = @outputs.relevantTickets
      search_tickets_for_reopen: @actions.get_relevant_tickets_by_description
        description: "Search relevant tickets when the employee wants to reopen a ticket."
        with userQuery = @system_variables.user_input
        with useCase = "reopenTicket"
        set @variables.last_ticket_search_results = @outputs.relevantTickets
      search_tickets_for_comment: @actions.get_relevant_tickets_by_description
        description: "Search relevant tickets when the employee wants to add a comment."
        with userQuery = @system_variables.user_input
        with useCase = "addCommentToTicket"
        set @variables.last_ticket_search_results = @outputs.relevantTickets
      summarize_ticket: @actions.summarize_ticket_for_employee
        description: "Summarize a selected ticket after the correct record has been identified."
        with "Input:recordId" = ...
        set @variables.last_ticket_summary = @outputs.promptResponse
      store_exact_comment_text: @utils.setVariables
        description: "Store the exact comment text after the employee confirms the wording."
        with pending_comment_text = ...
      mark_comment_confirmed: @utils.setVariables
        description: "Mark that the employee explicitly confirmed both the exact comment text and the target ticket."
        with comment_confirmed = True
      mark_reopen_confirmed: @utils.setVariables
        description: "Mark that the employee explicitly confirmed reopening the selected ticket."
        with reopen_confirmed = True
      add_comment: @actions.add_comment_to_ticket
        description: "Add the approved comment to the selected ticket after explicit confirmation."
        available when @variables.comment_confirmed == True and @variables.pending_comment_text != ""
        with recordID = ...
        with commentText = @variables.pending_comment_text
        set @variables.last_ticket_action_result = @outputs.outputMessage
      reopen_selected_ticket: @actions.reopen_ticket
        description: "Reopen the selected ticket after explicit confirmation."
        available when @variables.reopen_confirmed == True
        with recordId = ...
        set @variables.last_ticket_action_result = @outputs.resultSummary
      update_selected_jira_ticket: @actions.update_jira_issue
        description: "Update a Jira-backed ticket when an exact Jira key is known and the employee wants the Jira record changed."
        available when @variables.pending_jira_issue_key != ""
        with jiraIssueIdOrKey = @variables.pending_jira_issue_key
        with jiraSummary = ...
        with jiraImpactOptionId = ...
        with jiraUrgencyOptionId = ...
        with jiraSeverityOptionId = ...
        with commentText = @variables.pending_comment_text
        set @variables.last_jira_update_result = @outputs.message
      clear_followup_state: @utils.setVariables
        description: "Clear stored follow-up confirmation state after the employee changes course or after a follow-up action completes."
        with pending_comment_text = ""
        with comment_confirmed = False
        with reopen_confirmed = False
        with pending_jira_issue_key = ""
      go_to_shared_intake: @utils.transition to @topic.shared_service_request_intake
        description: "Return to shared intake when the request is for a new issue or a new service request."
      go_to_policy_query: @utils.transition to @topic.policy_query
        description: "Move to policy query if the employee switches to a company-policy question."
      go_to_escalation: @utils.transition to @topic.escalation
        description: "Move to escalation if the employee explicitly wants human help."
      back_to_router: @utils.transition to @topic.topic_router
        description: "Return to the main router when the conversation changes topics."

topic policy_query:
  description: "Answer employee questions about company policy, benefits, leave, reimbursements, and guidelines."
  actions:
    answer_policy_questions:
      description: "Answer employee questions about company policies by using the managed policy-answer prompt."
      inputs:
        "Input:userQuery": string
          description: "Employee question about company policy or benefits."
          is_required: True
      outputs:
        promptResponse: object
          description: "Policy answer returned by the managed prompt."
          complex_data_type_name: "lightning__richTextType"
          is_displayable: True
          is_used_by_planner: True
      target: "generatePromptResponse://svc_emp_intelligence__AnswerPolicyQuestions"
      source: "svc_emp_intelligence__AnswerPolicyQuestions"
  reasoning:
    instructions: ->
      if @variables.policy_answer != "":
        | Reuse this policy answer when it directly addresses the employee's follow-up: {!@variables.policy_answer}

      | Handle employee questions about company policies, benefits, leave, reimbursements, travel limits, entitlements, and internal guidelines.
      | If the policy question is unclear, ask a clarifying question before invoking the policy-answer action.
      | If the answer is incomplete or unclear, explain the policy in simpler language and offer to help interpret it further.
      | If the managed policy answer does not cover the request, guide the employee toward HR or the relevant team instead of inventing an answer.
    actions:
      answer_policy_question: @actions.answer_policy_questions
        description: "Answer the employee's company-policy question."
        with "Input:userQuery" = @system_variables.user_input
        set @variables.policy_answer = @outputs.promptResponse
      go_to_escalation: @utils.transition to @topic.escalation
        description: "Move to escalation when the employee needs human follow-up."
      back_to_router: @utils.transition to @topic.topic_router
        description: "Return to the main router when the conversation changes topics."

topic escalation:
  description: "Handle explicit requests for human assistance and guide employees to the live-help path."
  reasoning:
    instructions: |
      Help the employee get human support.
      Explain that this first Agent Script version is employee-agent-first and does not yet wire a messaging-specific live-transfer action.
      If the employee explicitly asks for human help, guide them to the IT help desk or support channel configured by the business and offer to summarize the issue for handoff.
      If the employee still wants the request logged instead of handoff, route them back to shared service intake or ticket follow-up, whichever best matches the request.
    actions:
      go_to_shared_intake: @utils.transition to @topic.shared_service_request_intake
        description: "Return to shared intake to log a new issue or service request."
      go_to_ticket_followup: @utils.transition to @topic.ticket_followup
        description: "Return to ticket follow-up for an existing incident, case, or service request."
      back_to_router: @utils.transition to @topic.topic_router
        description: "Return to the main router."

topic off_topic:
  description: "Politely redirect unsupported or unrelated requests back to the IT employee-assistant scope."
  reasoning:
    instructions: |
      Politely redirect the employee back to supported topics.
      Only support IT issues, service requests, IT ticket follow-up, policy questions, and requests for human IT help.
      For unrelated questions, state that you can help with IT and company-policy workflows and ask what the employee needs in that scope.

topic ambiguous_question:
  description: "Ask for clarification when the employee request is too vague to route or act on."
  reasoning:
    instructions: |
      Ask the employee for one or two specific clarifying details.
      Encourage them to focus on the single most important issue first.
      Do not guess which ticket, policy, or request they mean when the intent is still ambiguous.
